{
  "name": "turnmap-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Visualizer for Pydantic AI message histories: the turnmap React component and the turnmap.dev site",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/site",
    "build": "npm run build -w packages/turnmap && npm run build -w apps/site",
    "build:lib": "npm run build -w packages/turnmap",
    "build:site": "npm run build -w apps/site",
    "test": "npm run test -w packages/turnmap",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=20"
  }
}
